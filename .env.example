# Configuration des variables d'environnement pour le pipeline Open Food Facts
# Copiez ce fichier en '.env' et renseignez vos informations secrètes.

# Hugging Face Hub (requis pour scripts/publish_hub.py)
HF_TOKEN=hf_your_token_here
HF_REPO_ID=your_username/openfoodfacts-france-processed
HF_PRIVATE=True

# Base SQL PostgreSQL / Supabase (Optionnel : si omis, DuckDB local en mémoire ou fichier est utilisé)
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project
DB_PASSWORD=your_secure_password
# Ou URI directe :
DATABASE_URL=postgresql://postgres:password@localhost:5432/food_db

# Paramètres du Pipeline d'Ingestion
INGEST_MAX_PAGES=20
INGEST_PAGE_SIZE=100
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_SECONDS=30
INGEST_MAX_RETRIES=4
